{
  "name": "webapp",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "scripts": {
    "test:finance-fees": "node --experimental-strip-types --test --test-concurrency=1 test/finance-fees.test.mjs test/finance-fees-api.test.mjs test/finance-fees-ui.test.mjs test/finance-review.test.mjs",
    "test:treasury-payroll": "node --experimental-strip-types --test --test-concurrency=1 test/treasury-payroll-integrity.test.mjs test/treasury-payroll-ui.test.mjs",
    "test:finance-seed:local": "node --experimental-strip-types scripts/validate-finance-seed-local.mjs",
    "test:finance-fees:local": "node --experimental-strip-types scripts/validate-finance-fees-local.mjs",
    "test:backup-restore:local": "node --experimental-strip-types scripts/validate-backup-restore-local.mjs",
    "test:regressions": "node --experimental-strip-types scripts/run-finance-regressions.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:week-setup": "node --experimental-strip-types --test --test-concurrency=1 test/week-setup.test.mjs test/week-setup-api.test.mjs test/week-setup-ui.test.mjs",
    "test:week-setup:local": "node scripts/validate-week-setup-local.mjs",
    "test:teaching-load-matrix": "node --experimental-strip-types --test --test-concurrency=1 test/teaching-load-matrix.test.mjs test/teaching-load-matrix-api.test.mjs test/teaching-load-matrix-ui.test.mjs",
    "test:teaching-load-matrix:local": "node scripts/validate-teaching-load-matrix-local.mjs",
    "test:rbac": "node --experimental-strip-types --test test/rbac.test.mjs test/result-card.test.mjs test/settings-permissions.test.mjs test/tenant-targeting.test.mjs",
    "test:resource-access": "node --experimental-strip-types --test --test-concurrency=1 test/resource-access.test.mjs",
    "test:ui-foundations": "node --experimental-strip-types --test --test-concurrency=1 test/ui-foundations.test.mjs",
    "build": "vite build && vite build --config vite.worker.config.ts",
    "build:fe": "vite build",
    "build:api": "vite build --config vite.worker.config.ts",
    "preview": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy",
    "serve": "npx serve dist -l 3000 -s",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file=./seed.sql",
    "db:reset": "node scripts/reset-local-d1.mjs && npm run db:migrate && npm run db:seed",
    "test:api": "curl -s http://localhost:3000/api/schools | head -c 200",
    "test:security": "node --experimental-strip-types --test test/auth-security.test.mjs",
    "test:academic-years": "node --experimental-strip-types --test test/academic-years.test.mjs",
    "test:student-enrollments": "node --experimental-strip-types --test test/student-enrollments.test.mjs test/student-enrollment-bridge.test.mjs test/student-placement-ux.test.mjs",
    "test:student-promotion": "node --experimental-strip-types --test test/student-promotion.test.mjs test/student-promotion-ui.test.mjs",
    "test:student-profile": "node --experimental-strip-types --test test/student-profile.test.mjs",
    "test:flexible-grades": "node --experimental-strip-types --test test/flexible-grade-scheme.test.mjs",
    "test:grade-presentation": "node --experimental-strip-types --test test/grade-presentation.test.mjs",
    "test:result-cards": "node --experimental-strip-types --test test/result-card.test.mjs",
    "test:settings": "node --experimental-strip-types --test test/settings-permissions.test.mjs",
    "test:subject-order": "node --experimental-strip-types --test test/subject-order.test.mjs",
    "test:subject-management": "node --experimental-strip-types --test test/subject-management.test.mjs test/subject-order.test.mjs",
    "test:religious-subjects": "node --experimental-strip-types --test test/religious-subjects.test.mjs",
    "test:subject-applicability": "node --experimental-strip-types --test test/subject-applicability.test.mjs",
    "test:timetable": "node --experimental-strip-types --test --test-concurrency=1 test/timetable-foundation.test.mjs test/timetable-availability.test.mjs test/timetable-grid.test.mjs test/timetable-api.test.mjs test/timetable-grid-api.test.mjs test/timetable-ui.test.mjs test/timetable-master-views.test.mjs test/timetable-solver.test.mjs test/timetable-solver-api.test.mjs test/timetable-solver-ui.test.mjs test/timetable-adoption.test.mjs test/timetable-adoption-api.test.mjs test/timetable-adoption-ui.test.mjs",
    "test:excel-import": "node --experimental-strip-types --test test/excel-import.test.mjs test/grade-excel-import.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.5",
    "hono": "^4.13.7",
    "lucide-react": "^1.43.0",
    "postcss": "^8.5.28",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "happy-dom": "^20.14.0",
    "vite": "^6.4.3",
    "wrangler": "^4.130.0"
  }
}
